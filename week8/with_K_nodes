#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int solve(int src, int dest, int k, vector<vector<int>>& graph, vector<vector<int>>& dp)
{
    if(k == 0 && src == dest)
        return 0;

    if(k == 0)
        return INT_MAX;

    if(dp[src][k] != -1)
        return dp[src][k];

    int ans = INT_MAX;

    for(int v = 0; v < graph.size(); v++)
    {
        if(graph[src][v] != 0)
        {
            int temp = solve(v, dest, k - 1, graph, dp);

            if(temp != INT_MAX)
                ans = min(ans, graph[src][v] + temp);
        }
    }

    return dp[src][k] = ans;
}

int main()
{
    int n, e;
    cin >> n >> e;

    vector<vector<int>> graph(n, vector<int>(n, 0));

    for(int i = 0; i < e; i++)
    {
        int u, v, w;
        cin >> u >> v >> w;

        graph[u][v] = w;
    }

    int src, dest, k;
    cin >> src >> dest >> k;

    vector<vector<int>> dp(n, vector<int>(k + 1, -1));

    int ans = solve(src, dest, k, graph, dp);

    if(ans == INT_MAX)
        cout << "No Path";
    else
        cout << ans;

    return 0;
}